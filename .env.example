# Copy this file to .env and fill in your values before starting the dev server.
# In production (Railway), add these as environment variables in the dashboard.

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: leave as-is (SQLite file in the prisma/ directory)
# Production (Railway): set this to the path on your persistent volume, e.g.:
#   DATABASE_URL="file:/data/spotid.db"
# Make sure to mount a Railway volume at /data and run "npx prisma migrate deploy"
# in the Railway deploy command before the app starts.
DATABASE_URL="file:./dev.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In production: NEXTAUTH_URL="https://spotidapp.com"

# ── Admin panel ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=""
NEXT_PUBLIC_ADMIN_EMAIL=""

# ── SMTP (email) ──────────────────────────────────────────────────────────────
# Leave blank in dev — emails are logged to the console instead.
# Recommended provider: Resend (https://resend.com) — free tier 3k/mo
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend           SMTP_PASS=re_yourApiKey
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SpotId <noreply@spotidapp.com>"

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# A long random string used to authenticate cron calls.
# Generate: openssl rand -base64 32
# Pass as header: Authorization: Bearer <value>
CRON_SECRET="replace-with-a-random-secret"

# ── Cloudflare R2 (file uploads / images) ────────────────────────────────────
# Leave blank in dev — images are saved to /public/uploads/ locally instead.
# In production ALL five values are required or uploads will fail.
#
# Setup steps:
#  1. Cloudflare Dashboard → R2 → Create bucket (e.g. "spotid-uploads")
#  2. R2 → Manage R2 API Tokens → Create token with Object Read & Write on that bucket
#  3. Copy your Account ID from the R2 overview page (top right)
#  4. Enable "Public access" on the bucket — add custom domain:
#       e.g. assets.spotidapp.com  →  CNAME  →  <bucket>.<accountid>.r2.dev
#
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="spotid-uploads"
# Public CDN base URL — no trailing slash
# Example: https://assets.spotidapp.com
R2_PUBLIC_URL=""
